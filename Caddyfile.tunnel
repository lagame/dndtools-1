:80 {
    encode zstd gzip
    handle_path /static/media/* {
        root * /var/www/media
        file_server
    }
    handle_path /static/* {
        root * /var/www/static
        file_server
    }
    handle_path /media/* {
        root * /var/www/media
        file_server
    }
    reverse_proxy app:8765 {
        header_up X-Forwarded-Proto https
    }
}
