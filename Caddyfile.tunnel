:80 {
    @www host www.dndtools.quest
    redir @www https://dndtools.quest{uri} permanent
    encode zstd gzip
    redir /forum /forum/ 308
    handle_path /forum/* {
        @private path /config.php /store/* /files/* /cache/* /install/*
        respond @private 404
        reverse_proxy forum:80
    }
    handle_path /static/media/* {
        root * /var/www/media
        file_server
    }
    handle_path /static/* {
        root * /var/www/static
        file_server
    }
    handle_path /media/* {
        root * /var/www/media
        file_server
    }
    reverse_proxy app:8765 {
        header_up X-Forwarded-Proto https
    }
}
