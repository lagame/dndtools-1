# Copy to .env and replace every change-me value before starting Compose.
DND_DB_NAME=dndtools
DND_DB_USER=dndtools
DND_DB_PASSWORD=change-me-db-password
DND_MYSQL_ROOT_PASSWORD=change-me-root-password
DND_SECRET_KEY=change-me-long-random-django-secret
DND_DEBUG=1
DND_ALLOWED_HOSTS=127.0.0.1,localhost
DND_CSRF_TRUSTED_ORIGINS=http://127.0.0.1:8765,http://localhost:8765
DND_PUBLIC_HOST=127.0.0.1:8765
