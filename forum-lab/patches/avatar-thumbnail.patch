+/** Cache a small, freshly encoded avatar for lists and navigation. */
+function dndtools_make_avatar_thumb($source, $target)
+{
+	$info = @getimagesize($source);
+	if (!$info || $info[2] !== IMAGETYPE_WEBP || $info[0] < 1 || $info[1] < 1 ||
+		$info[0] > 2048 || $info[1] > 2048 || $info[0] * $info[1] > 4194304 ||
+		@filesize($source) > 524288)
+	{
+		return false;
+	}
+
+	$image = @imagecreatefromwebp($source);
+	if (!$image)
+	{
+		return false;
+	}
+
+	$side = min($info[0], $info[1]);
+	$thumb = imagecreatetruecolor(64, 64);
+	imagealphablending($thumb, false);
+	imagesavealpha($thumb, true);
+	imagecopyresampled($thumb, $image, 0, 0,
+		(int) (($info[0] - $side) / 2), (int) (($info[1] - $side) / 2),
+		64, 64, $side, $side);
+	imagedestroy($image);
+
+	$directory = dirname($target);
+	if (!is_dir($directory) && !@mkdir($directory, 0750, true))
+	{
+		imagedestroy($thumb);
+		return false;
+	}
+	$temp = @tempnam($directory, 'thumb_');
+	$written = $temp && @imagewebp($thumb, $temp, 82) && @rename($temp, $target);
+	imagedestroy($thumb);
+	if ($temp && !$written)
+	{
+		@unlink($temp);
+	}
+	return $written;
+}
